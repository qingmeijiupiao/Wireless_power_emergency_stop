menu "Emergency stop controller"
    config ESTOP_OLED_SDA
        int "OLED SDA GPIO"
        range 0 21
        default 1
    config ESTOP_OLED_SCL
        int "OLED SCL GPIO"
        range 0 21
        default 2
    config ESTOP_OLED_COLUMN_OFFSET
        int "SH1106 visible column offset"
        range 0 4
        default 2
endmenu
